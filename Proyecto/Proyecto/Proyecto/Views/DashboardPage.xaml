<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Proyecto.Views.DashboardPage">

    <StackLayout Padding="20">
        <Label Text="Dashboard" FontSize="Large" HorizontalOptions="CenterAndExpand" />

        <Button Text="Crear Doctor" Clicked="OnCrearDoctorClicked"/>
        <Button Text="Crear Paciente" Clicked="OnCrearPacienteClicked"/>
        <Button Text="Crear Cita" Clicked="OnCrearCitaClicked"/>

        <Label Text="Filtrar Anuncios" FontSize="Medium" />

        <Picker x:Name="doctorPicker" Title="Seleccionar Doctor" />
        <Picker x:Name="pacientePicker" Title="Seleccionar Paciente" />
        <DatePicker x:Name="fechaPicker" />

        <Button Text="Filtrar Anuncios" Clicked="OnFiltrarAnunciosClicked" />

        <ListView x:Name="anunciosListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Texto}" Detail="{Binding FechaPublicacion}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>

</ContentPage>
